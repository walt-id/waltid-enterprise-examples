# Walt.id Enterprise API
# Base URL of the Enterprise Stack instance
WALTID_API_URL=http://waltid.enterprise.localhost:3000
WALTID_API_URL_PUBLIC=https://your-public-url.ngrok-free.app

# Service account credentials for server-side API calls
WALTID_USERNAME=superadmin@walt.id
WALTID_PASSWORD=super123456

# Organization ID
WALTID_ORGANIZATION=waltid

# Acme Tenant Configuration
ACME_TENANT=acme-demo

# Enterprise service targets
WALTID_ISSUER_TARGET=waltid.dept-identity.identity-issuer
WALTID_VERIFIER_TARGET=waltid.gov-central.verifier2

# Generic wallet actor metadata
WALTID_WALLET_METADATA_NAME=Acme
WALTID_WALLET_ISSUER_METADATA_NAME=Acme Issuer
WALTID_WALLET_METADATA_LOGO_URI=https://raw.githubusercontent.com/walt-id/waltid-enterprise-examples/5a3bf02f04a071d6ecc81e85e9e6492513d782b4/waltid-acme-demo/public/acme-logo.png
WALTID_WALLET_METADATA_CLIENT_URI=https://walt.id

# walt.id Enterprise API
# Base URL of the Enterprise Stack instance
WALTID_API_URL=http://waltid.enterprise.localhost:3000
WALTID_API_URL_PUBLIC=https://your-public-url.ngrok-free.app

# Service account credentials for server-side API calls
WALTID_USERNAME=superadmin@walt.id
WALTID_PASSWORD=super123456

# Organization ID
WALTID_ORGANIZATION=waltid

# Central government tenant
GOV_CENTRAL_TENANT=gov-central

# Department tenant IDs
GOV_DEPT_HR=dept-hr
GOV_DEPT_IDENTITY=dept-identity
GOV_DEPT_REVENUE=dept-revenue
GOV_DEPT_FINANCE=dept-finance
GOV_UNTRUSTED_TENANT=untrusted-dept

# Central verifier target ({org}.{tenant}.{verifier})
GOV_VERIFIER_TARGET=waltid.gov-central.verifier2

# VCT base URL for SD-JWT credentials (typically same as public URL)
GOV_VCT_BASE_URL=https://your-public-url.ngrok-free.app

# Demo credentials for authorization code flow
NEXT_PUBLIC_DEMO_USERNAME=user@example.com
NEXT_PUBLIC_DEMO_PASSWORD=password123
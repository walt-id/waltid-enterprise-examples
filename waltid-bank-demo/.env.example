# walt.id Enterprise API
# Base URL of the Enterprise Stack instance
WALTID_API_URL=https://your-instance.enterprise.waltid.cloud
WALTID_API_URL_PUBLIC=https://your-instance.enterprise.waltid.cloud


# Service account credentials for server-side API calls (issuance, SSE proxy)
WALTID_USERNAME=superadmin@walt.id
WALTID_PASSWORD=your-password

# Issuer2 Service target identifier ({org}.{tenant}.{issuer})
WALTID_ISSUER_TARGET=your-org.your-tenant.your-issuer

# Verifier2 Service target identifier ({org}.{tenant}.{verifier})
WALTID_VERIFIER_TARGET=your-org.your-tenant.your-verifier

# Optional: override the signing key used by the Issuer2 profile at runtime
# Leave empty to use the key configured in the credential profile
ISSUER_KEY_ID=

# Optional: override the x509 certificate chain for issuance at runtime (PEM string)
# Leave empty to use the chain configured in the credential profile
ISSUER_X5C=

# Verifier identity — used to sign/identify verification requests
# Client ID in x509_hash format (hash of the verifier leaf certificate)
VERIFIER_CLIENT_ID=x509_hash:<sha256-hash-of-verifier-leaf-cert>

# Verifier private key in JWK format
VERIFIER_KEY='{"type":"jwk","jwk":{"crv":"P-256","d":"<private-key-d>","kty":"EC","x":"<public-key-x>","y":"<public-key-y>"}}'

# Verifier x509 certificate chain as a JSON array of base64-encoded DER certificates
# Order: [leaf, intermediate, root]
VERIFIER_X5C='["<leaf-cert-base64>","<intermediate-cert-base64>","<root-cert-base64>"]'

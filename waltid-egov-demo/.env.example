# ─────────────────────────────────────────────
#  Digital Government Services Demo — Environment
# ─────────────────────────────────────────────

# ── walt.id Enterprise Stack ──────────────────

# Internal API base URL (server-side calls)
WALTID_API_URL=enterprise.localhost

# Public-facing URL used in wallet QR callbacks (must be reachable by the mobile wallet)
WALTID_API_URL_PUBLIC=enterprise.localhost

# Enterprise Stack admin credentials
WALTID_USERNAME=user@example.com
WALTID_PASSWORD=your-password

# Organisation slug (top-level org in the Enterprise Stack)
WALTID_ORGANIZATION=demo-org

# ── e-Gov Portal — eID Issuer ─────────────────
# Tenant and issuer for the Government Identity Authority
# Profile ID resolved as: {WALTID_ORGANIZATION}.{GOV_ISSUER_TENANT}.{GOV_ISSUER_NAME}.national-id
# e.g. demo-org.gov.eid-issuer.national-id

GOV_ISSUER_TENANT=gov
GOV_ISSUER_NAME=eid-issuer

# ── e-Tax Portal — Tax Issuer + Verifier ──────
# Tenant and issuer/verifier for the Revenue Authority
# Issuer profile ID resolved as: {WALTID_ORGANIZATION}.{TAX_TENANT}.{TAX_ISSUER_NAME}.tax-cert
# e.g. demo-org.tax.tax-issuer.tax-cert

TAX_TENANT=tax
TAX_ISSUER_NAME=tax-issuer

# Full verifier target path used when creating VP sessions for the eID login flow
# Format: {WALTID_ORGANIZATION}.{TAX_TENANT}.{verifier-name}
TAX_VERIFIER_TARGET=demo-org.tax.tax-verifier

# ── TLS ───────────────────────────────────────
# Set to 0 for self-signed / ngrok sandbox certificates
NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Optional ──────────────────────────────────
# PORT=3004
